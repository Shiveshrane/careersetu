# ── outlrn-backend Environment ──
# Copy this file to .env and fill in your values.

# ── LLM Provider ──
# Works with OpenAI, Groq, or any OpenAI-compatible API.
# Use OPENAI_API_KEY + OPENAI_BASE_URL for OpenAI/custom providers,
# or GROQ_API_KEY + GROQ_BASE_URL as aliases for Groq.
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Groq aliases (used if OPENAI_* vars are not set)
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── Model Config ──
# LLM used for lesson orchestration (must support JSON mode)
LLM_MODEL=openai/gpt-oss-20b

# TTS model and voice (only used if OpenAI TTS is enabled)
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
